{
  "name": "@jpowersdev/effect-rx-playground",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.10.0",
  "license": "MIT",
  "description": "Effect Rx Playground",
  "repository": {
    "type": "git",
    "url": "https://github.com/jpowersdev/effect-rx-playground"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "build": "tsup && pnpm copy-package-json",
    "build:ts": "tsup",
    "dev": "bun run --hot src/main.ts",
    "clean": "rimraf dist/*",
    "check": "tsc -b tsconfig.json",
    "lint": "eslint \"**/{src,test,examples,scripts,dtslint}/**/*.{ts,mjs}\"",
    "lint-fix": "pnpm lint --fix",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "copy-package-json": "tsx scripts/copy-package-json.ts"
  },
  "devDependencies": {
    "@effect/cli": "^0.59.16",
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "^0.9.1",
    "@effect/platform": "^0.80.16",
    "@effect/vitest": "^0.20.17",
    "@eslint/compat": "1.2.8",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.25.1",
    "@types/bun": "^1.2.11",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "bun-plugin-tailwind": "^0.0.15",
    "effect": "^3.14.16",
    "eslint": "^9.25.1",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-codegen": "0.30.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "pnpm": {
    "patchedDependencies": {}
  },
  "dependencies": {
    "@effect-rx/rx": "^0.38.7",
    "@effect-rx/rx-react": "^0.33.6",
    "@effect/ai": "^0.13.16",
    "@effect/ai-openai": "^0.16.17",
    "@effect/cluster": "^0.30.4",
    "@effect/experimental": "^0.44.16",
    "@effect/opentelemetry": "^0.46.13",
    "@effect/platform-browser": "^0.60.7",
    "@effect/platform-bun": "^0.61.4",
    "@effect/rpc": "^0.56.4",
    "@effect/sql": "^0.33.16",
    "@effect/sql-pg": "^0.34.16",
    "@opentelemetry/sdk-logs": "^0.200.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-trace-web": "^2.0.0",
    "@tanstack/react-query": "^5.74.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.5.3",
    "tailwindcss": "^4.1.5",
    "waku": "^0.22.4"
  },
  "private": true
}
